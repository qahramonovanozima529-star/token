PORT=5000
MONGO_URI=mongodb://localhost:27017/token_auth_db

# JWT Secrets - generate strong random strings for production!
# openssl rand -hex 64
ACCESS_TOKEN_SECRET=your_very_strong_access_token_secret_here
REFRESH_TOKEN_SECRET=your_very_strong_refresh_token_secret_here

# Token lifetimes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Cookie settings
NODE_ENV=development

